# ── 依赖 ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*

# ── 运行时用户数据（重要）─────────────────────────────────────────
# data/ 由应用启动时自动创建（见 server/app.js 的 fs.mkdirSync(dataRoot)），
# 内含 SQLite 数据库、真实相册照片、计划、发布与备份文件，属个人数据，
# 且随使用不断变化，不应纳入版本管理。删除本目录不影响应用启动。
data/

# ── 本地工具状态 ──────────────────────────────────────────────────
# 工作记忆日志等本地状态，不参与代码版本管理。
.workbuddy/

# ── 临时文件与日志 ────────────────────────────────────────────────
*.log
*.tmp
*.temp
_probe*
~$*

# ── 操作系统 ──────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── 编辑器 / IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
